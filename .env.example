# ==============================================================================
# Misa AI v9.0.0 — Environment Configuration Example
# ==============================================================================

# Supabase New API Key Architecture (Phase 41+)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy Keys (Supported for backward compatibility)
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_JWT_SECRET=optional-legacy-symmetric-jwt-secret

# Telegram Bot Integration (Phase 39 / Phase 46 Production)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Misa_ai_agent_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_WEBHOOK=true
TELEGRAM_ADMIN_USER_ID=

# Railway / Production URLs
# RAILWAY_PUBLIC_DOMAIN is set automatically by Railway (e.g. your-service.up.railway.app)
RAILWAY_PUBLIC_DOMAIN=
MISA_PUBLIC_URL=
MISA_BACKEND_URL=

# Misa Multi-Provider LLM System (Phase 49+ / v9.0.0)
# Tier 1 Primary Candidates & Specialized Fallbacks
MISA_GROQ_API_KEY=gsk_...
MISA_GEMINI_API_KEY=AIzaSy...
MISA_CEREBRAS_API_KEY=csk-...
MISA_OPENROUTER_API_KEY=sk-or-v1-...
MISA_NVIDIA_API_KEY=nvapi-...

# Legacy / Direct Provider Aliases (Supported for backward compatibility)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=

# Misa API Server & Security
MISA_API_HOST=127.0.0.1
MISA_API_PORT=18420
MISA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost
ENVIRONMENT=development
