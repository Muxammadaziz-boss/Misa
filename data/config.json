{
  "app": {
    "version": "9.0.1",
    "name": "Misa AI",
    "debug": false
  },
  "audio": {
    "sample_rate": 44100,
    "duration": 5,
    "channels": 1,
    "tts_voice_male": "uz-UZ-SardorNeural",
    "tts_voice_female": "uz-UZ-MadinaNeural",
    "tts_rate": 200,
    "vad_enabled": true,
    "vad_threshold": 0.015,
    "silence_duration": 1.2,
    "tts_speed": 1.0,
    "tts_engine": "edge_tts",
    "auto_speak": true
  },
  "gui": {
    "theme": "oled",
    "color_scheme": "green",
    "compact_mode": true,
    "window_size": "1100x800",
    "compact_window_size": "1168x700+26+26",
    "font_family": "Segoe UI",
    "font_size": 12,
    "color": "green",
    "animations": true,
    "glassmorphism": true
  },
  "paths": {
    "commands_file": "commands.json",
    "history_file": "buyruqlar_tarixi.txt",
    "reminders_file": "eslatmalar.txt",
    "temp_dir": "",
    "user_file": "foydalanuvchi_ismi.txt",
    "voice_file": "ovoz_turi.txt"
  },
  "api": {
    "openrouter_model": "openai/gpt-3.5-turbo",
    "speech_language": "uz-UZ",
    "timeout": 15
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file_name": "yordamchi.log",
    "max_file_size": 10485760,
    "backup_count": 5
  },
  "user": {
    "name": "test",
    "voice_type": "erkak",
    "avatar": "emerald",
    "role": "Dasturchi / Muhandis",
    "bio": "Misa AI shaxsiy sun'iy intellekt yordamchisi",
    "language": "uz"
  },
  "voice": {
    "tts_engine": "edge_tts",
    "silero_model": "uz-UZ-MadinaNeural",
    "speed": 1.0,
    "sample_rate": 44100
  },
  "ai": {
    "model": "openrouter",
    "timeout": 15,
    "mode": "creative",
    "thinking_enabled": true,
    "gemini_api_key": ""
  },
  "notifications": {
    "scheduler": true,
    "voice": true,
    "sound_effects": false,
    "system_status": true
  },
  "privacy": {
    "local_storage_only": true,
    "telemetry_disabled": true,
    "save_conversations": true
  },
  "providers": {
    "groq": {
      "enabled": true,
      "priority": 95,
      "timeout": 15.0,
      "base_url": "https://api.groq.com/openai/v1",
      "default_model": "llama-3.3-70b-versatile"
    },
    "cerebras": {
      "enabled": true,
      "priority": 92,
      "timeout": 15.0,
      "base_url": "https://api.cerebras.ai/v1",
      "default_model": "llama-3.3-70b"
    },
    "gemini": {
      "enabled": true,
      "priority": 94,
      "timeout": 15.0,
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "default_model": "gemini-2.0-flash"
    },
    "openrouter": {
      "enabled": true,
      "priority": 80,
      "timeout": 20.0,
      "base_url": "https://openrouter.ai/api/v1",
      "default_model": "meta-llama/llama-3.3-70b-instruct:free"
    },
    "nvidia": {
      "enabled": true,
      "priority": 74,
      "timeout": 20.0,
      "base_url": "https://integrate.api.nvidia.com/v1",
      "default_model": "meta/llama-3.3-70b-instruct"
    }
  }
}